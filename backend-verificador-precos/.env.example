# ==========================================
# VERIFICADOR DE PREÇOS - CONFIGURAÇÕES
# ==========================================

# Banco de dados MySQL
DB_NAME=verificador_precos
DB_USER=USUARIO_MYSQL
DB_PASSWORD=SENHA_MYSQL
DB_HOST=localhost
DB_PORT=3306

# Django
DJANGO_SECRET_KEY=CHAVE_SECRETA
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Imagens dos produtos
# Endereço público que antecede media/img_produtos/
IMAGENS_BASE_URL=http://127.0.0.1:8000/

# Diretório físico que contém a pasta img_produtos
IMAGENS_STORAGE_ROOT=D:/CAMINHO_DO_PROJETO/media
